committed*
# Built binary matches `committed*` above; un-ignore Go sources so files
# like e2e/cdc/harness/committed.go don't silently disappear from commits.
!*.go
vendor
raft-*
debug
data
example-data
entry-log
state-log
.vscode
.idea
.claude/
.claude-scratch/
.worktrees/
docker/db
demo/db

wal.test

# Captured old-binary fixture data dirs (e2e/upgrade): generated on demand by
# capture-fixture.sh from the pinned release tags and cached locally — real
# old-binary bytes, but never committed.
e2e/upgrade/testdata/*/datadir/
